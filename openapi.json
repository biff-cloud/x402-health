{
 "openapi": "3.1.0",
 "info": {
  "title": "x402 Health (x402)",
  "description": "Health checks, uptime history and a reliability-ranked directory of x402 services, paid per call in USDC on Solana via x402. Informational only; no guarantee of any listed service.",
  "version": "1.0.0"
 },
