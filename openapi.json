     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/v1/check": {
   "get": {
    "summary": "Check",
    "description": "Probe a URL now: reachability, HTTP 402 validity, accepted network/price/payTo, latency, plus 7-day history.",
    "operationId": "check_v1_check_get",
    "parameters": [
     {
      "name": "url",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "description": "x402 resource URL to probe",
       "title": "Url"
      },
      "description": "x402 resource URL to probe"
     },
     {
      "name": "method",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(GET|POST)$",
       "default": "GET",
       "title": "Method"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     },
     "402": {
      "description": "Payment Required (x402 v2; see PAYMENT-REQUIRED header)"
     }
    },
    "x-payment-info": {
     "protocols": [
      "x402"
     ],
     "price": {
      "mode": "fixed",
      "currency": "USD",
      "amount": "0.005"
     },
